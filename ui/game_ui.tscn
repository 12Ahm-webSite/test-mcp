theme_override_colors/font_color = Color(1, 0.35, 0.35, 1)
theme_override_font_sizes/font_size = 32
text = "💀 CAUGHT! 💀"
horizontal_alignment = 1

[node name="LoseDesc" type="Label" parent="EndScreen/LosePanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "The robot caught you before you finished!"
horizontal_alignment = 1

[node name="RestartButton" type="Button" parent="EndScreen/LosePanel/VBoxContainer"]
