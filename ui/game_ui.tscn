[node name="GameUI" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="HUD" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="MarginContainer" type="MarginContainer" parent="HUD"]
layout_mode = 0
offset_left = 24.0
offset_top = 24.0
offset_right = 360.0
offset_bottom = 110.0

[node name="PanelContainer" type="PanelContainer" parent="HUD/MarginContainer"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_hud")

[node name="VBoxContainer" type="VBoxContainer" parent="HUD/MarginContainer/PanelContainer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ScoreLabel" type="Label" parent="HUD/MarginContainer/PanelContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "💎 Crystals: 0 / 10"

[node name="HintLabel" type="Label" parent="HUD/MarginContainer/PanelContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.82, 0.88, 1)
theme_override_font_sizes/font_size = 14
text = "WASD: Move | SPACE: Jump | Collect all 10!"

[node name="EndScreen" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="WinPanel" type="PanelContainer" parent="EndScreen"]
visible = false
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_win")

[node name="VBoxContainer" type="VBoxContainer" parent="EndScreen/WinPanel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="WinTitle" type="Label" parent="EndScreen/WinPanel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 1.0, 0.5, 1)
theme_override_font_sizes/font_size = 32
text = "🎉 VICTORY! 🎉"
horizontal_alignment = 1

[node name="WinDesc" type="Label" parent="EndScreen/WinPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "You collected all 10 crystals and escaped!"
horizontal_alignment = 1

[node name="RestartButton" type="Button" parent="EndScreen/WinPanel/VBoxContainer"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 18
text = "Play Again"

[node name="LosePanel" type="PanelContainer" parent="EndScreen"]
visible = false
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_lose")

[node name="VBoxContainer" type="VBoxContainer" parent="EndScreen/LosePanel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="LoseTitle" type="Label" parent="EndScreen/LosePanel/VBoxContainer"]
